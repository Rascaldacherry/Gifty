# Copy to .env at the repository root. All keys stay on the backend.
DATABASE_URL=postgresql+psycopg://gifty:gifty_local@localhost:5432/gifty
POSTGRES_USER=gifty
POSTGRES_PASSWORD=gifty_local
POSTGRES_DB=gifty
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
SESSION_DAYS=14
DEMO_ENABLED=true
# demo | openai_compatible | yandex | gigachat
AI_PROVIDER=demo
# A deployment decision; user consent alone does not enable external processing.
EXTERNAL_PROCESSING_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
YANDEX_FOLDER_ID=
GIGACHAT_ACCESS_TOKEN=
SPEECHKIT_API_KEY=
SPEECHKIT_FOLDER_ID=
# Optional partner catalog exports. Empty = clearly labelled mock catalog.
OZON_CATALOG_FILE=
WILDBERRIES_CATALOG_FILE=
YANDEX_MARKET_CATALOG_FILE=
